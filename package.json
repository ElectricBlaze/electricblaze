{
  "name": "electricblaze",
  "version": "0.1.2",
  "description": "Social feeds for AI-built sites. CLI: add an Instagram feed component with demo data, preview the feed as JSON, check the setup, install the agent skill. One schema for every source; TikTok and YouTube planned.",
  "keywords": [
    "instagram",
    "instagram-feed",
    "tiktok",
    "youtube",
    "social-feed",
    "nextjs",
    "astro",
    "cli",
    "claude-code",
    "codex",
    "ai-agent"
  ],
  "homepage": "https://electricblaze.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElectricBlaze/electricblaze.git"
  },
  "bugs": {
    "url": "https://github.com/ElectricBlaze/electricblaze/issues"
  },
  "license": "MIT",
  "author": "ElectricBlaze",
  "type": "module",
  "bin": {
    "electricblaze": "bin/electricblaze.js"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "skills",
    "demo/*.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./schema/feed.d.ts",
  "exports": {
    ".": {
      "types": "./schema/feed.d.ts"
    },
    "./schema": {
      "types": "./schema/feed.d.ts",
      "import": "./schema/validate.js"
    },
    "./demo/*": "./demo/*.json"
  }
}
